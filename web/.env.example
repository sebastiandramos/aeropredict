# AeroPredict — variables de entorno del frontend

# URL base de la API de predicción (FastAPI).
# En desarrollo con el proxy de Vite, usa /api (same-origin, sin CORS).
VITE_API_BASE_URL=http://localhost:8000

# Modo mock: true (por defecto) usa datos simulados y funciona sin backend.
# Ponlo a false para conectar con la API real.
VITE_USE_MOCK=true

# Clave opcional X-API-Key si el servidor la exige (dejar vacío si no).
# VITE_API_KEY=
